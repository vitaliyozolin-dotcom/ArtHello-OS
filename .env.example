# Runtime
NODE_ENV=development
PORT=8080
APP_ORIGINS=
TRUST_PROXY_HOPS=0

# PostgreSQL
DATABASE_URL=
TEST_DATABASE_URL=

# Owner authentication
DASHBOARD_PASSWORD=
SESSION_SECRET=

# Optional restricted roles. Leave disabled until branch/legal-entity
# predicates and their negative tests are approved.
ACCOUNTANT_PASSWORD=
ACCOUNTANT_BRANCH_IDS=
ACCOUNTANT_LEGAL_ENTITY_IDS=
VIEWER_PASSWORD=
VIEWER_BRANCH_IDS=
VIEWER_LEGAL_ENTITY_IDS=

# AlfaCRM — dedicated read-only technical account only
ALFACRM_DOMAIN=
ALFACRM_EMAIL=
ALFACRM_API_KEY=

# Bank connector config vault.
# Generate independent 32-byte keys and store their base64 values in this
# JSON keyring. Rotate by adding a new key id, switching the active id, and
# re-encrypting configs before removing an old key.
BANK_CONFIG_ACTIVE_KEY_ID=
BANK_CONFIG_ENCRYPTION_KEYS=

# One-time legacy bank config encryption migration.
# Never set these during normal runtime.
BANK_CONFIG_MIGRATION_CONFIRM=
BANK_CONFIG_MIGRATION_BACKUP_ID=

# Optional integrations; do not configure before their quality gates.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID_PROMOTION=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
