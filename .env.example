# Runtime
NODE_ENV=development
PORT=8080
APP_ORIGINS=
TRUST_PROXY_HOPS=0

# PostgreSQL
DATABASE_URL=
TEST_DATABASE_URL=

# Personal authentication policy. Users and password hashes live in PostgreSQL.
AUTH_SESSION_TTL_MS=28800000
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_LOCK_MS=900000

# One-time owner bootstrap. Set only for the create-owner command, then remove.
AUTH_BOOTSTRAP_OWNER_LOGIN=
AUTH_BOOTSTRAP_OWNER_NAME=
AUTH_BOOTSTRAP_OWNER_PASSWORD=

# AlfaCRM — dedicated read-only technical account only
ALFACRM_DOMAIN=
ALFACRM_EMAIL=
ALFACRM_API_KEY=

# Bank connector encrypted config vault
BANK_CONFIG_ACTIVE_KEY_ID=
BANK_CONFIG_ENCRYPTION_KEYS=
BANK_CONFIG_MIGRATION_CONFIRM=
BANK_CONFIG_MIGRATION_BACKUP_ID=

# Optional integrations; keep empty before their quality gates
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID_PROMOTION=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

VITE_FRONT_OFFICE_PREVIEW=false
FRONT_OFFICE_INTERNAL_ALPHA_ENABLED=false
SMSVIZITKA_SHADOW_ENABLED=false
SMSVIZITKA_WEBHOOK_TOKEN=
FRONT_OFFICE_PHONE_MATCH_SECRET=
