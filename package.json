{
  "name": "school-1-11",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "build:selfhost": "npm run build",
    "build:sites-legacy": "bash scripts/build-verified.sh",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "start:selfhost": "npm run start",
    "start:sites-legacy": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/registration-contract.test.mjs tests/school-structure-contract.test.mjs tests/phone-auth-contract.test.mjs tests/central-access-contract.test.mjs tests/central-family-directory.test.mjs tests/identity-broker-contract.test.mjs tests/design-code-contract.test.mjs",
    "test:design-code": "node --test tests/design-code-contract.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "auth:bootstrap-owner": "node scripts/bootstrap-owner.mjs",
    "migrate:d1-snapshot": "node scripts/build-migration-db.mjs",
    "backup": "node scripts/backup-db.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Школа 1–11"
}
