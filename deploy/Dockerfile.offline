FROM arthello-os-api:local

USER root
WORKDIR /school

COPY deploy/offline-runtime-v3.part-* /tmp/runtime-v3-parts/
COPY deploy/offline-runtime-v4-delta.part-* /tmp/runtime-v4-parts/
COPY deploy/offline-runtime-v5-delta.part-* /tmp/runtime-v5-parts/

RUN cat /tmp/runtime-v3-parts/offline-runtime-v3.part-* > /tmp/school-runtime-v3.tar.gz \
    && printf '%s  %s\n' \
      '9125b43319706f4bf3a9a45813b50a0495e61bef5b73f3305a1b97717406b349' \
      '/tmp/school-runtime-v3.tar.gz' \
      | sha256sum --check --strict \
    && tar -xzf /tmp/school-runtime-v3.tar.gz -C /school \
    && cat /tmp/runtime-v4-parts/offline-runtime-v4-delta.part-* > /tmp/school-runtime-v4-delta.tar.gz \
    && printf '%s  %s\n' \
      'a4ef97eb6795cb81c860ab62b0ae7510e693b1fec1e5f6129aea072ce2ca2c9f' \
      '/tmp/school-runtime-v4-delta.tar.gz' \
      | sha256sum --check --strict \
    && tar -xzf /tmp/school-runtime-v4-delta.tar.gz -C /school \
    && cat /tmp/runtime-v5-parts/offline-runtime-v5-delta.part-* > /tmp/school-runtime-v5-delta.tar.gz \
    && printf '%s  %s\n' \
      'cfeb2cd1ac663a082d7bb2369f2c8490fcd1cfead4436e169a4183d21ff69dce' \
      '/tmp/school-runtime-v5-delta.tar.gz' \
      | sha256sum --check --strict \
    && tar -xzf /tmp/school-runtime-v5-delta.tar.gz -C /school \
    && rm -f /tmp/school-runtime-v3.tar.gz /tmp/school-runtime-v4-delta.tar.gz /tmp/school-runtime-v5-delta.tar.gz \
    && rm -rf /tmp/runtime-v3-parts /tmp/runtime-v4-parts /tmp/runtime-v5-parts \
    && chmod 0755 /school/scripts/container-entrypoint.sh \
    && mkdir -p /data /backups \
    && chown -R node:node /school /data /backups

# Overlay the dependency-free release importer from the exact delivery SHA.
# The prebuilt runtime archive contains the interactive application, while
# these files are deliberately kept auditable and executable without ExcelJS.
COPY --chown=node:node lib/curriculum-allocation.mjs /school/lib/curriculum-allocation.mjs
COPY --chown=node:node scripts/import-school-curriculum.mjs /school/scripts/import-school-curriculum.mjs

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV DATABASE_PATH=/data/school-1-11.sqlite

USER node
EXPOSE 3000

ENTRYPOINT ["./scripts/container-entrypoint.sh"]
CMD ["node", "server.js"]
