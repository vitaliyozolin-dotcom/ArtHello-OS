FROM arthello-os-api:local

USER root
WORKDIR /school

COPY deploy/offline-runtime-v3.part-* /tmp/runtime-v3-parts/
COPY deploy/offline-runtime-v4-delta.part-* /tmp/runtime-v4-parts/

RUN cat /tmp/runtime-v3-parts/offline-runtime-v3.part-* > /tmp/school-runtime-v3.tar.gz \
    && printf '%s  %s\n' \
      '9125b43319706f4bf3a9a45813b50a0495e61bef5b73f3305a1b97717406b349' \
      '/tmp/school-runtime-v3.tar.gz' \
      | sha256sum --check --strict \
    && tar -xzf /tmp/school-runtime-v3.tar.gz -C /school \
    && cat /tmp/runtime-v4-parts/offline-runtime-v4-delta.part-* > /tmp/school-runtime-v4-delta.tar.gz \
    && printf '%s  %s\n' \
      '84a453f982dd99cec14ec2ebc7a05c0cfd319d8b3ec9bf47a1da79bc6801554b' \
      '/tmp/school-runtime-v4-delta.tar.gz' \
      | sha256sum --check --strict \
    && tar -xzf /tmp/school-runtime-v4-delta.tar.gz -C /school \
    && rm -f /tmp/school-runtime-v3.tar.gz /tmp/school-runtime-v4-delta.tar.gz \
    && rm -rf /tmp/runtime-v3-parts /tmp/runtime-v4-parts \
    && mkdir -p /data /backups \
    && chown -R node:node /school /data /backups

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV DATABASE_PATH=/data/school-1-11.sqlite

USER node
EXPOSE 3000

ENTRYPOINT ["./scripts/container-entrypoint.sh"]
CMD ["node", "server.js"]
