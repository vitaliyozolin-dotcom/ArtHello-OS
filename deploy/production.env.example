NODE_ENV=production
PORT=8080
TRUST_PROXY_HOPS=1
APP_ORIGINS=https://os.arthelloteam.ru

POSTGRES_DB=arthello
POSTGRES_USER=arthello
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_VALUE
DATABASE_URL=postgresql://arthello:CHANGE_ME_LONG_RANDOM_VALUE@db:5432/arthello

AUTH_SESSION_TTL_MS=28800000
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_LOCK_MS=900000

ALFACRM_DOMAIN=
ALFACRM_EMAIL=
ALFACRM_API_KEY=

BANK_CONFIG_ACTIVE_KEY_ID=
BANK_CONFIG_ENCRYPTION_KEYS=

FRONT_OFFICE_INTERNAL_ALPHA_ENABLED=false
SMSVIZITKA_SHADOW_ENABLED=false
SMSVIZITKA_WEBHOOK_TOKEN=
FRONT_OFFICE_PHONE_MATCH_SECRET=
