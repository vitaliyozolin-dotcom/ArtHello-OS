[Unit]
Description=ArtHello owner backup control over Unix socket
After=local-fs.target
RequiresMountsFor=/var/backups/arthello-v52

[Service]
Type=simple
User=root
Group=arthello-backup-control
UMask=0007
StateDirectory=arthello-v52-backup-control
StateDirectoryMode=0750
ExecStart=/usr/bin/python3 /usr/local/lib/arthello-v52-backup/bridge.py
Restart=on-failure
RestartSec=5
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
NoNewPrivileges=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
