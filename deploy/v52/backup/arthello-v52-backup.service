[Unit]
Description=ArtHello v52 verified SQLite backup
After=local-fs.target
RequiresMountsFor=/var/backups/arthello-v52

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/arthello-v52-backup/backup.py --config /etc/arthello-v52-backup.json
TimeoutStartSec=16min
KillMode=control-group
ProtectSystem=strict
ReadWritePaths=/var/backups/arthello-v52
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
NoNewPrivileges=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
StandardOutput=journal
StandardError=journal
