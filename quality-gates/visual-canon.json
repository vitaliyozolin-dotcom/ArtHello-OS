{
  "schema_version": 3,
  "source_of_truth": "ArtHello OS Design Code 1.2",
  "viewports": [
    {
      "id": "desktop",
      "width": 1440,
      "height": 900,
      "deviceScaleFactor": 1
    },
    {
      "id": "mobile",
      "width": 390,
      "height": 844,
      "deviceScaleFactor": 1
    }
  ],
  "rules": {
    "root_must_render": true,
    "max_horizontal_overflow_px": 2,
    "interactive_viewport_tolerance_px": 2,
    "dialog_center_tolerance_px": 40
  },
  "approved_invariants": [
    {
      "id": "layout-no-horizontal-overflow",
      "description": "The rendered application must not create page-level horizontal overflow."
    },
    {
      "id": "interactive-elements-stay-in-viewport",
      "description": "Visible buttons, links, inputs and controls must remain inside the viewport horizontally."
    },
    {
      "id": "dialogs-centered-when-visible",
      "description": "A visible modal/dialog must remain inside the viewport and visually centered."
    },
    {
      "id": "render-evidence-required",
      "description": "Every proof-gate run captures desktop and mobile screenshots as CI evidence."
    },
    {
      "id": "compact-card-typography-matches-access",
      "description": "Compact list cards and embedded compact empty states use the approved Access typography roles."
    },
    {
      "id": "compact-registry-kpi-matches-approved-scale",
      "description": "Operational registry KPI cards use the approved Contractor geometry and typography at desktop and mobile widths."
    }
  ],
  "compact_card_typography": {
    "title": {
      "font_size_px": 12,
      "line_height_px": 15,
      "font_weight": 500
    },
    "body": {
      "font_size_px": 10,
      "line_height_px": 14,
      "font_weight": 400
    },
    "index": {
      "font_size_px": 9,
      "line_height_px": 12,
      "font_weight": 800
    }
  },
  "compact_registry_kpi": {
    "scope": "operational registries; excludes Home and separately approved overview KPI patterns",
    "tokens_prefix": "--ah-registry-kpi-",
    "grid": {
      "four_columns_min_width_px": 1025,
      "two_columns_min_width_px": 360,
      "two_columns_max_width_px": 1024,
      "single_column_max_width_px": 359
    },
    "desktop": {
      "min_width_px": 721,
      "gap_px": 12,
      "min_height_px": 98,
      "border_radius_px": 16,
      "padding_block_px": 16,
      "padding_inline_px": 16,
      "label": {
        "font_size_px": 13,
        "line_height_px": 18,
        "font_weight": 400
      },
      "value": {
        "font_size_px": 24,
        "line_height_px": 28,
        "font_weight": 700,
        "margin_top_px": 5
      },
      "note": {
        "font_size_px": 12,
        "line_height_px": 17,
        "font_weight": 400,
        "margin_top_px": 4
      }
    },
    "mobile": {
      "max_width_px": 720,
      "gap_px": 11,
      "min_height_px": 84,
      "border_radius_px": 13,
      "padding_block_px": 11,
      "padding_inline_px": 12,
      "label": {
        "font_size_px": 11,
        "line_height_px": 13,
        "font_weight": 400
      },
      "value": {
        "font_size_px": 26,
        "line_height_px": 28,
        "font_weight": 700,
        "margin_top_px": 3
      },
      "note": {
        "font_size_px": 11,
        "line_height_px": 13,
        "font_weight": 400,
        "margin_top_px": 3
      }
    }
  }
}
